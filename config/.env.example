# 텔레그램 알림 설정
# 이 파일을 config/.env 로 복사해 실제 값을 넣으세요. .env는 git에 올라가지 않습니다.
#
# 1) 텔레그램에서 @BotFather 에게 /newbot → 봇 이름 지정 → 토큰 발급
# 2) 발급받은 토큰을 아래에 붙여넣기
# 3) 내가 만든 봇을 찾아 /start 또는 아무 메시지나 전송
# 4) ./.venv/bin/python src/alerter.py --chat-id  실행 → 나온 값을 TELEGRAM_CHAT_ID 에 입력
# 5) ./.venv/bin/python src/alerter.py --notify-test  로 연결 확인

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 토스증권 Open API (자동매매용)
# 1) https://developers.tossinvest.com 에서 앱 등록 → client id/secret 발급
# 2) 아래 두 값을 넣고 ./.venv/bin/python src/alerter.py --toss-accounts 실행
# 3) 출력된 accountSeq 를 TOSS_API_ACCOUNT_SEQ 에 입력
#    (계좌번호 accountNo 가 아니라 accountSeq 다. 주문 API의 X-Tossinvest-Account 헤더 값)
#
# ⚠️ IP 허용 목록 등록이 먼저입니다. 등록하지 않으면 토큰 발급이
#    403 access_denied "IP address not allowed" 로 막힙니다.
#    현재 공개 IP: curl -s https://api.ipify.org
#    가정용 회선은 IP가 바뀔 수 있으니 바뀌면 재등록해야 합니다.
#
# ⚠️ 이 값이 채워지면 --live 로 실제 주문이 나갈 수 있습니다.
#    주문을 즉시 멈추려면 config/HALT 파일을 만드세요 (킬 스위치).
TOSS_API_CLIENT_ID=
TOSS_API_CLIENT_SECRET=
TOSS_API_ACCOUNT_SEQ=
